{
  "//": [
    "Composite indexes for the queries the app makes. Deploy with:",
    "  firebase deploy --only firestore:indexes",
    "Most lists are sorted on the device, so only multi-field filters need one."
  ],
  "indexes": [
    {
      "//": "UsersRemoteDataSource.watchStudentsIn — role == student && section_id in [...]",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "role", "order": "ASCENDING" },
        { "fieldPath": "section_id", "order": "ASCENDING" }
      ]
    },
    {
      "//": "UsersRemoteDataSource.watchTeachersOf — role == teacher && section_ids array-contains",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "role", "order": "ASCENDING" },
        { "fieldPath": "section_ids", "arrayConfig": "CONTAINS" }
      ]
    },
    {
      "//": "ContentRemoteDataSource.watchForStudent — published && student_ids array-contains",
      "collectionGroup": "content",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "published", "order": "ASCENDING" },
        { "fieldPath": "student_ids", "arrayConfig": "CONTAINS" }
      ]
    },
    {
      "//": "ContentRemoteDataSource.watchForStudent — published && section_ids array-contains",
      "collectionGroup": "content",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "published", "order": "ASCENDING" },
        { "fieldPath": "section_ids", "arrayConfig": "CONTAINS" }
      ]
    },
    {
      "//": "AttendanceRemoteDataSource.watchSectionDay — section_id == && date ==",
      "collectionGroup": "attendance",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "section_id", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
